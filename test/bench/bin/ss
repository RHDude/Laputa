#!/usr/bin/env python3
# Подставной ss: слушающие сокеты и соединения из $FAKE_SS.
import json, os, sys
try:
    c = json.load(open(os.environ.get('FAKE_SS', '/nonexistent')))
except Exception:
    c = {}
args = ' '.join(sys.argv[1:])
if 'ltnup' in args:
    for l in c.get('listen', []):
        print('tcp   LISTEN 0      4096   0.0.0.0:%d   0.0.0.0:*   users:(("proc",pid=%d,fd=3))' % (l['port'], l['pid']))
elif 'established' in args:
    for i, e in enumerate(c.get('est', [])):
        print('0      0      10.0.0.5:%d     %s:%d' % (e['lport'], e['peer'], 40000 + i))
