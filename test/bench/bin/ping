#!/usr/bin/env python3
import os, sys
ip = sys.argv[-1]
dead = os.environ.get('FAKE_DEAD', '').split(',')
print('PING %s (%s) 56(84) bytes of data.' % (ip, ip))
if ip in dead:
    print('--- %s ping statistics ---\n3 packets transmitted, 0 received, 100%% packet loss, time 2040ms' % ip); sys.exit(1)
print('--- %s ping statistics ---\n3 packets transmitted, 3 received, 0%% packet loss, time 2003ms\nrtt min/avg/max/mdev = 1.100/2.500/3.900/0.400 ms' % ip)
